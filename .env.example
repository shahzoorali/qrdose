# Public base URL of the app (used to build QR / NFC trigger URLs)
APP_BASE_URL=http://localhost:3000

# AWS — all services run in N. Virginia
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB single-table name
DYNAMODB_TABLE=QRdose

# SNS — us-east-1 origination number / sender ID for US (+1) SMS delivery.
# Leave blank to let SNS choose a default origination identity.
SNS_SENDER_ID=

# Auth.js (NextAuth v5) — generate a secret with: openssl rand -base64 32
AUTH_SECRET=
# Trust the host header (needed behind proxies / non-localhost hosts)
AUTH_TRUST_HOST=true

# Optional: enforce one trigger per card per N seconds (default 60)
TRIGGER_COOLDOWN_SECONDS=60

# Password reset code lifetime in seconds (default 900 = 15 min)
RESET_CODE_TTL_SECONDS=900

# Google Places API — address autocomplete on signup (US only)
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# ── Medication reminders ────────────────────────────────────────────
# Verified SES sender. Leave blank to disable reminder emails (SMS still works).
SES_FROM_EMAIL=QRdose <alerts@qrdose.com>

# Region holding the verified SES identity. SES identities are per-region and
# qrdose.com is verified in ap-south-1, while everything else runs in us-east-1.
SES_REGION=ap-south-1

# Shared secret the reminder cron requires in the x-cron-secret header.
# Leave blank to keep the cron endpoint disabled. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# Minutes after a scheduled dose before the user is reminded, for accounts
# that haven't set their own. Contacts are escalated to at double this.
DEFAULT_REMINDER_GRACE_MINUTES=30

# A scan confirms any dose scheduled within this many minutes of it.
DOSE_MATCH_WINDOW_MINUTES=180

# ── Stripe (billing) ────────────────────────────────────────────────
# Billing stays fully disabled until ALL THREE are set. Until then the
# billing page shows "coming soon" and no subscription is required.
# STRIPE_PRICE_ID is the recurring Price id for the $5.99/mo plan
# (e.g. price_xxx, from the "QRDose Monthly" product, prod_xxx), not the
# product id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
